root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.cpp]
indent_style = space
indent_size = 4

[*.h]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,sh,ts,js}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false